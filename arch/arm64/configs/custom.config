# Localversion
CONFIG_LOCALVERSION="-Extreme-KSUNv3.4.0-DS@ravindu644"

# KernelSU-Next
CONFIG_KSU=y
CONFIG_KSU_ALLOWLIST_WORKAROUND=y
CONFIG_KSU_MANUAL_HOOK=y

# TTL fix for VirtualAP
CONFIG_NETFILTER_XT_TARGET_HL=y

# USB gadget functions for NetHunter (rubber ducky, mass storage, CDC).
# Full self-contained list; some are already enabled by the base
# defconfig but are kept here so this fragment stands on its own.
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_USB_F_HID=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_F_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_F_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_F_ACM=y
CONFIG_USB_CONFIGFS_OBEX=y
CONFIG_USB_F_OBEX=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_F_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_F_ECM=y
CONFIG_USB_CONFIGFS_ECM_SUBSET=y
CONFIG_USB_F_SUBSET=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_F_RNDIS=y
CONFIG_USB_CONFIGFS_EEM=y
CONFIG_USB_F_EEM=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_F_FS=y

# USB host-side CDC ACM modem (Proxmark and similar)
CONFIG_USB_ACM=y
